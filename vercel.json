{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build"
  "functions": {
    "api/*.py": {
      "runtime": "python3.9"
    },
    "api/**/*.py": {
      "runtime": "python3.9"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
