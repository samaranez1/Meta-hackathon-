<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX package manifest template for Space Shooters (Win32-packaged Godot game).
     Tokens __IDENTITY_NAME__ / __PUBLISHER__ / __VERSION__ / __EXE_NAME__ are
     filled in by Build-Msix.ps1 - or edit them by hand. Identity Name and
     Publisher MUST match your Partner Center app identity exactly. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">
  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Space Shooters</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Capabilities>
    <!-- Standard for Win32 games packaged as MSIX; declare it in Partner Center. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="SpaceShooters" Executable="__EXE_NAME__" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Space Shooters" Description="A fast vertical space shooter: 5 sectors, 5 bosses." BackgroundColor="#0a0a24"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
